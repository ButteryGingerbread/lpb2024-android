<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.lpb2024.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.lpb2024.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register" />

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.lpb2024.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_displayAllFragment"
            app:destination="@id/displayAllFragment" />
        <action
            android:id="@+id/action_homeFragment_to_blankFragment"
            app:destination="@id/blankFragment" />
        <action
            android:id="@+id/action_homeFragment_to_customerFragment"
            app:destination="@id/customerFragment" />

    </fragment>

    <fragment
        android:id="@+id/displayAllFragment"
        android:name="com.example.lpb2024.DisplayAllFragment"
        android:label="Display All">
        <action
            android:id="@+id/action_displayAllFragment_to_singleMenuFragment"
            app:destination="@id/singleMenuFragment" />
    </fragment>

    <fragment
        android:id="@+id/singleMenuFragment"
        android:name="com.example.lpb2024.singleMenuFragment"
        android:label="Single Menu">
        <!-- Optional arguments -->
        <argument
            android:name="recipe_id"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/emptyFragment"
        android:name="com.example.lpb2024.BlankFragment"
        android:label="Empty Fragment" />


    <fragment
        android:id="@+id/customerFragment"
        android:name="com.example.lpb2024.CustomerFragment"
        android:label="Customers"
        tools:layout="@layout/fragment_customer" />

    <fragment
        android:id="@+id/blankFragment"
        android:name="com.example.lpb2024.BlankFragment"
        android:label="Blank Fragment">
        <action
            android:id="@+id/action_blankFragment_to_singleMenuFragment"
            app:destination="@id/singleMenuFragment" />
    </fragment>

</navigation>